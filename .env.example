# --- Database (Neon Postgres): copy BOTH strings from Neon > Connect ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# --- Sign-in ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated Gmail / company addresses allowed into /admin
ADMIN_EMAILS=you@gmail.com
ADMIN_TZ=Asia/Kolkata

# --- AI provider: gemini (default) | groq | openai | anthropic ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: several keys / a custom model list (tried in order)
# GEMINI_API_KEYS=key1,key2
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Hosting ---
PORT=3000
# NODE_ENV=production
# KEEP_WARM=1
